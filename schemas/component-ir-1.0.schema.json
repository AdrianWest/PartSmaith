    "footprint": {
      "type": "object",
      "properties": {
        "land_pattern_source": {
          "enum": [
            "MANUFACTURER",
            "STANDARD",
            "USER_OVERRIDE"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          }
        },
        "status": {
          "enum": [
            "DIRECT",
            "DERIVED",
            "STANDARD",
            "UNKNOWN",
            "INFERRED",
            "AMBIGUOUS",
            "CONFLICTING",
            "MISSING",
            "USER_OVERRIDE"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "standard_id": {
          "type": "string",
          "minLength": 1
        },
        "override_id": {
          "type": "string",
          "minLength": 1
        }
