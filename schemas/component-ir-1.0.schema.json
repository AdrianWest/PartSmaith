    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standard"
      },
      "minItems": 0
