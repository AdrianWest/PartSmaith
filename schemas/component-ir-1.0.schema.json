      "additionalProperties": false
    },
    "electrical": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      },
      "minItems": 1
    },
    "package": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
