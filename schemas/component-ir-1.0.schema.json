        "variant": {
          "type": "string",
          "minLength": 1
        },
        "pdl_id": {
          "type": "string",
          "minLength": 1
        },
        "pdl_revision": {
          "type": "string",
          "minLength": 1
        },
        "pin_count": {
          "type": "integer",
          "minimum": 1
        },
        "mechanical": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          },
          "minProperties": 1
        },
        "status": {
          "enum": [
            "DIRECT",
            "DERIVED",
            "STANDARD",
            "UNKNOWN",
            "INFERRED",
            "AMBIGUOUS",
            "CONFLICTING",
            "MISSING",
            "USER_OVERRIDE"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "standard_id": {
          "type": "string",
          "minLength": 1
        },
        "override_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "family",
        "variant",
        "pin_count",
        "mechanical",
        "status",
        "evidence_ids"
