        "source_max": {
          "type": "number"
        },
        "normalized_min": {
          "type": "number"
        },
        "normalized_max": {
          "type": "number"
        },
        "status": {
          "enum": [
            "DIRECT",
            "DERIVED",
            "STANDARD",
            "UNKNOWN",
            "INFERRED",
            "AMBIGUOUS",
            "CONFLICTING",
            "MISSING",
            "USER_OVERRIDE"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
