{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bft://schemas/phase8-contracts/1.0",
  "title": "PartSmith Phase 8 Contracts 1.0",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "not_generatable": {
      "type": "object",
      "properties": {
        "missing": {
          "$ref": "#/$defs/nonempty_string"
        },
        "importance": {
          "$ref": "#/$defs/nonempty_string"
        },
        "blocked_artifact": {
          "$ref": "#/$defs/nonempty_string"
        },
        "unblocking_evidence": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "missing",
        "importance",
        "blocked_artifact",
        "unblocking_evidence"
      ],
      "additionalProperties": false
    },
    "warning_policy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "policy_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "rule_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "scope": {
          "$ref": "#/$defs/nonempty_string"
        },
        "rationale": {
          "$ref": "#/$defs/nonempty_string"
        },
        "required_reviewer_decision": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "policy_id",
        "rule_id",
        "scope",
        "rationale",
        "required_reviewer_decision"
      ],
      "additionalProperties": false
    },
    "validation_result": {
      "type": "object",
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "stage": {
          "enum": [
            "INPUT",
            "ARTIFACT",
            "FINAL_ARTIFACT",
            "POST_MANIFEST",
            "REPRODUCIBILITY"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "HUMAN_REVIEW",
            "NOT_GENERATABLE",
            null
          ]
        },
        "applicability": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        }
      },
      "required": [
        "rule_id",
        "stage",
        "status",
        "applicability"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "NOT_APPLICABLE"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "status": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "engineering_manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "component_identity": {
          "type": "object",
          "minProperties": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "documents": {
              "type": "array",
              "minItems": 1
            },
            "hashes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "documents",
            "hashes"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "package": {
              "type": "array"
            },
            "hashes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "package",
            "hashes"
          ],
          "additionalProperties": false
        },
        "component_ir": {
          "type": "object",
          "properties": {
            "schema_version": {
              "$ref": "#/$defs/nonempty_string"
            },
            "input_snapshot_hash": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "schema_version",
            "input_snapshot_hash"
          ],
          "additionalProperties": false
        },
        "pdl": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "revision": {
              "$ref": "#/$defs/nonempty_string"
            },
            "hash": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "id",
            "revision",
            "hash"
          ],
          "additionalProperties": false
        },
        "generators": {
          "$ref": "#/$defs/three_artifact_map"
        },
        "outputs": {
          "$ref": "#/$defs/three_artifact_map"
        },
        "validation": {
          "type": "object",
          "properties": {
            "overall": {
              "$ref": "#/$defs/nonempty_string"
            },
            "results": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/validation_result"
              },
              "minItems": 1
            }
          },
          "required": [
            "overall",
            "results"
          ],
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "kicad": {
              "type": "object",
              "minProperties": 1
            }
          },
          "required": [
            "kicad"
          ],
          "additionalProperties": false
        },
        "overrides": {
          "type": "object",
          "properties": {
            "active_content_hashes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "active_content_hashes"
          ],
          "additionalProperties": false
        },
        "reproducibility": {
          "type": "object",
          "properties": {
            "build_inputs_hash": {
              "$ref": "#/$defs/sha256"
            },
            "dependency_hashes": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/sha256"
              },
              "minProperties": 1
            }
          },
          "required": [
            "build_inputs_hash",
            "dependency_hashes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "component_identity",
        "source",
        "evidence",
        "component_ir",
        "pdl",
        "generators",
        "outputs",
        "validation",
        "compatibility",
        "overrides",
        "reproducibility"
      ],
      "additionalProperties": false
    },
    "three_artifact_map": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "object",
          "minProperties": 1
        },
        "footprint": {
          "type": "object",
          "minProperties": 1
        },
        "model_3d": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "symbol",
        "footprint",
        "model_3d"
      ],
      "additionalProperties": false
    },
    "audit_envelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "build_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "build_status": {
          "$ref": "#/$defs/nonempty_string"
        },
        "started_at": {
          "$ref": "#/$defs/nonempty_string"
        },
        "completed_at": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ir_record_hash": {
          "$ref": "#/$defs/sha256"
        },
        "engineering_manifest_hash": {
          "$ref": "#/$defs/sha256"
        },
        "reviews": {
          "type": "array"
        },
        "historical_evidence_and_override_refs": {
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "build_id",
        "build_status",
        "started_at",
        "completed_at",
        "ir_record_hash",
        "engineering_manifest_hash",
        "reviews",
        "historical_evidence_and_override_refs"
      ],
      "additionalProperties": false
    },
    "release_report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "summary": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/nonempty_string"
            },
            "errors": {
              "type": "array"
            },
            "warnings": {
              "type": "array"
            },
            "review_items": {
              "type": "array"
            },
            "declared_exclusions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/validation_result"
              }
            }
          },
          "required": [
            "status",
            "errors",
            "warnings",
            "review_items",
            "declared_exclusions"
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array"
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_result"
          }
        },
        "evidence": {
          "type": "array"
        },
        "mapping": {
          "type": "object"
        },
        "compatibility": {
          "type": "object"
        },
        "reproducibility": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "summary",
        "artifacts",
        "validation",
        "evidence",
        "mapping",
        "compatibility",
        "reproducibility"
      ],
      "additionalProperties": false
    },
    "post_manifest_report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "manifest_hash": {
          "$ref": "#/$defs/sha256"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_result"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "manifest_hash",
        "results"
      ],
      "additionalProperties": false
    },
    "input_review_proposal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "candidate_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        },
        "actions": {
          "type": "array",
          "items": {
            "const": "EVIDENCE_REVIEW"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "base_revision_id",
        "base_revision_hash",
        "expected_head_hash",
        "candidate_revision_id",
        "candidate_revision_hash",
        "inventory_sha256",
        "reason",
        "actions"
      ],
      "additionalProperties": false
    },
    "input_approval_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "proposal_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "proposal_hash": {
          "$ref": "#/$defs/sha256"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "candidate_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "candidate_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer": {
          "$ref": "#/$defs/nonempty_string"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "proposal_id",
        "proposal_hash",
        "component_id",
        "candidate_revision_id",
        "candidate_revision_hash",
        "expected_head_hash",
        "inventory_sha256",
        "reviewer",
        "reason"
      ],
      "additionalProperties": false
    },
    "input_rejection_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "proposal_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "proposal_hash": {
          "$ref": "#/$defs/sha256"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "candidate_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "candidate_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer": {
          "$ref": "#/$defs/nonempty_string"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "proposal_id",
        "proposal_hash",
        "component_id",
        "candidate_revision_id",
        "candidate_revision_hash",
        "expected_head_hash",
        "reviewer",
        "reason"
      ],
      "additionalProperties": false
    },
    "override_proposal_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
        },
        "new_value": {},
        "evidence_reference": {
          "$ref": "#/$defs/nonempty_string"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "base_revision_id",
        "base_revision_hash",
        "expected_head_hash",
        "path",
        "new_value",
        "evidence_reference",
        "reason"
      ],
      "additionalProperties": false
    },
    "conflict_resolution_proposal_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "target_path": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
        },
        "selected_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "superseded_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "override_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonempty_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "$ref": "#/$defs/nonempty_string"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "base_revision_id",
        "base_revision_hash",
        "expected_head_hash",
        "target_path",
        "selected_evidence_ids",
        "superseded_evidence_ids",
        "override_id",
        "decision",
        "reason"
      ],
      "additionalProperties": false
    },
    "evidence_exclusion_proposal_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "replacement_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "base_revision_id",
        "base_revision_hash",
        "expected_head_hash",
        "evidence_id",
        "replacement_evidence_ids",
        "reason"
      ],
      "additionalProperties": false
    },
    "pin_reorder_proposal_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "base_revision_id",
        "base_revision_hash",
        "expected_head_hash",
        "terminal_order",
        "reason"
      ],
      "additionalProperties": false
    },
    "bundle_index": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "bundle_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "availability": {
          "enum": [
            "OFFLINE_COMPLETE",
            "RETRIEVAL_REQUIRED"
          ]
        },
        "component": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/nonempty_string"
            },
            "manufacturer": {
              "$ref": "#/$defs/nonempty_string"
            },
            "mpn": {
              "$ref": "#/$defs/nonempty_string"
            },
            "package_variant": {
              "$ref": "#/$defs/nonempty_string"
            }
          },
          "required": [
            "id",
            "manufacturer",
            "mpn",
            "package_variant"
          ],
          "additionalProperties": false
        },
        "head_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identity": {
                "$ref": "#/$defs/nonempty_string"
              },
              "kind": {
                "enum": [
                  "IR_REVISION",
                  "ACQUISITION_INVENTORY"
                ]
              },
              "schema_version": {
                "$ref": "#/$defs/nonempty_string"
              },
              "path": {
                "$ref": "#/$defs/nonempty_string"
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "metadata": {
                "type": "object"
              }
            },
            "required": [
              "identity",
              "kind",
              "schema_version",
              "path",
              "byte_length",
              "sha256",
              "metadata"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "bundle_id",
        "availability",
        "component",
        "head_revision_id",
        "objects"
      ],
      "additionalProperties": false
    },
    "pin_removal_proposal_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "component_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "base_revision_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_head_hash": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "required": [
        "schema_version",
        "component_id",
        "base_revision_id",
        "base_revision_hash",
        "expected_head_hash",
        "terminal_order",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
