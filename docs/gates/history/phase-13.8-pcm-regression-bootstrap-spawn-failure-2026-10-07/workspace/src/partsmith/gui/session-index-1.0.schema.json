{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bft://schemas/desktop-session/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "database_sha256", "objects"],
  "properties": {
    "schema_version": {"const": "partsmith-session-1.0"},
    "database_sha256": {"$ref": "#/$defs/digest"},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["setup", "status", "logs", "budgets"],
      "properties": {
        "setup": {"type": "object"}, "source": {"$ref": "#/$defs/asset"},
        "extraction": {"$ref": "#/$defs/asset"}, "ai": {"type": ["object", "null"]},
        "drafts": {"type": "object"}, "viewer": {"type": "object"},
        "integration": {"$ref": "#/$defs/integration"},
        "history": {"type": "array"}, "component_id": {"type": "string"},
        "revision_id": {"type": "string"}, "inventory_sha256": {"$ref": "#/$defs/digest"},
        "pdl": {"type": ["object", "null"]}, "build_id": {"type": ["string", "null"]},
        "proposal": {"type": ["object", "null"]}, "release": {"type": ["object", "null"]},
        "status": {"type": "string"}, "acquisition_id": {"type": "string"},
        "logs": {"type": "array", "items": {"type": "string"}},
        "budgets": {"type": "object", "additionalProperties": false,
          "required": ["object_bytes", "archive_bytes", "expanded_bytes", "object_count", "log_bytes", "image_cache_bytes", "mesh_bytes"],
          "properties": {
            "object_bytes": {"type": "integer", "minimum": 1},
            "archive_bytes": {"type": "integer", "minimum": 1},
            "expanded_bytes": {"type": "integer", "minimum": 1},
            "object_count": {"type": "integer", "minimum": 1},
            "log_bytes": {"type": "integer", "minimum": 1},
            "image_cache_bytes": {"type": "integer", "minimum": 1},
            "mesh_bytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "objects": {"type": "object", "propertyNames": {"$ref": "#/$defs/digest"},
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["sha256", "size"], "properties": {
          "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "project_id", "drafts"],
      "properties": {
        "schema_version": {"const": "partsmith-session-integration-1.0"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "drafts": {"type": "array", "maxItems": 10000,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["attempt_id", "plan_hash", "manifest_hash"],
            "properties": {
              "attempt_id": {"type": ["string", "null"], "maxLength": 1024},
              "plan_hash": {"$ref": "#/$defs/digest"},
              "manifest_hash": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
            }
          }
        }
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset": {"type": "object", "additionalProperties": false,
      "required": ["$asset"], "properties": {"$asset": {"$ref": "#/$defs/digest"}}}
  }
}
